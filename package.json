{
  "name": "tower-siege",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev-playgama": "vite --mode playgama",
    "dev-poki": "vite --mode poki",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "build:crazy-web": "vite build --mode crazy-web --base=./ ",
    "build:wavedash": "vite build --mode wavedash --base=./ --outDir=wavedash-dist && wavedash build push",
    "build:itch": "vite build --mode itch --base=./ && cd dist && tar -a -cf ../tower-siege-itch.zip * && cd .. && move tower-siege-itch.zip dist\\",
    "build:glitch": "vite build --mode glitch --base=./ && cd dist && tar -a -cf ../tower-siege-glitch.zip * && cd .. && move tower-siege-glitch.zip dist\\",
    "build:game-distribution": "vite build --mode game-distribution --base=./",
    "build:playgama": "vite build --mode playgama --base=./ && cd dist && tar -a -cf ../tower-siege-playgama.zip * && cd .. && move tower-siege-playgama.zip dist\\",
    "build:gamepix": "vite build --mode gamepix --base=./ && cd dist && tar -a -cf ../tower-siege-gamepix.zip * && cd .. && move tower-siege-gamepix.zip dist\\",
    "build:gamemonetize": "vite build --mode gamemonetize --base=./ && cd dist && tar -a -cf ../tower-siege-gamemonetize.zip * && cd .. && move tower-siege-gamemonetize.zip dist\\",
    "build:poki": "vite build --mode poki --base=./ && cd dist && tar -a -cf ../tower-siege-poki.zip * && cd .. && move tower-siege-poki.zip dist\\",
    "build:yandex": "vite build --mode yandex --base=./ && cd dist && tar -a -cf ../tower-siege-yandex.zip * && cd .. && move tower-siege-yandex.zip dist\\",
    "build-github-main": "vite build --base=/tower-siege/ --outDir=dist",
    "build-github-develop": "vite build --base=/tower-siege/develop/ --outDir=dist/develop",
    "deploy": "vite build && surge dist/ --domain tower-siege.surge.sh",
    "validated-build": "vue-tsc -b && vite build",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "slice-sheets": "node tools/slice-sheets.mjs",
    "slice-sheets-only": "node tools/slice-sheets.mjs --only ribbon",
    "art:prompts": "node --import ./tools/ts-resolve.mjs tools/art-prompts.mjs",
    "art:status": "node --import ./tools/ts-resolve.mjs tools/art-status.mjs",
    "art:export": "node tools/export-sheets.mjs",
    "art:desk": "node tools/art-desk/server.mjs",
    "art:measure": "python tools/measure-art.py",
    "compress-folder": "node scripts/compress-images.mjs",
    "compress-bench": "node scripts/image-compress-bench.mjs",
    "compress:images": "node scripts/compress-images.mjs public/images --backup-dir public-backup",
    "leaderboard:snapshot": "node scripts/leaderboard-snapshot.mjs",
    "leaderboard:seed": "node scripts/leaderboard-seed.mjs",
    "perf:preview": "vite build && vite preview --port 4177 --strictPort",
    "perf:ab": "node tools/perf-ab.mjs --url http://localhost:4177/index.html --gpu --reps 5 --frames 1800 --warmframes 240 --throttle 4 --viewport 412x915x2 --seed 7 --tier mid --wave 10 --warmup 1",
    "preview:video": "node tools/preview-video/record.mjs",
    "perf:profile-build": "vite build --minify false --outDir dist-prof",
    "perf:profile": "node tools/perf-profile.mjs --url http://localhost:4178/index.html --gpu --throttle 4 --wave 10 --tier mid"
  },
  "dependencies": {
    "@vueuse/core": "^14.2.1",
    "@wvdsh/sdk-js": "^0.0.38",
    "lodash.clonedeep": "^4.5.0",
    "vue": "^3.5.29",
    "vue-i18n": "^11.2.8",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@intlify/unplugin-vue-i18n": "^11.0.7",
    "@napi-rs/image": "^1.14.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/node": "^24.11.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/language-plugin-pug": "^3.2.5",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.27",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^28.1.0",
    "npm-run-all2": "^8.0.4",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.8",
    "pug": "^3.0.3",
    "sass": "^1.97.3",
    "sass-loader": "^16.0.7",
    "sharp": "^0.35.4",
    "ssim.js": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^25.5.0 || >=22.12.0"
  },
  "pnpm": {
    "//": "ffmpeg-static IS a postinstall download — blocked by default, the binary is absent and `pnpm preview:video` fails on a null path.",
    "onlyBuiltDependencies": [
      "ffmpeg-static"
    ]
  }
}
